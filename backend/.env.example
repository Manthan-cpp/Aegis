# --- Gemini (preferred chatbot generation, free tier available) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_MS=15000

# --- Groq (fallback generation) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# --- Ollama (offline fallback only; models should be stored on D:) ---
OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_SECONDS=12

# --- MongoDB Atlas (M0 free cluster) ---
MONGODB_URI=
MONGODB_DB_NAME=aegis

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- OmniDimension browser voice bridge ---
# Keep these values in backend/.env only. Never expose the API key in Next.js.
OMNIDIM_API_KEY=
OMNIDIM_AGENT_ID=
# Separate agent for the live companion conversation. Do not reuse the trusted-contact agent.
OMNIDIM_COMPANION_AGENT_ID=
OMNIDIM_BASE_URL=https://omnidim.io/api/v1

# --- EmailJS help email integration ---
# EmailJS public key is safe to use with a predefined template; never put an
# email account password or private key in the frontend.
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
# Required when EmailJS Account -> Security -> API access is set to Strict.
# Keep this only in backend/.env; never put it in the frontend.
EMAILJS_PRIVATE_KEY=
# Demo mode routes the women-support option to the demo inbox below.
EMAIL_DEMO_MODE=true
EMAIL_DEMO_RECIPIENT=
# Keep this empty until a verified production authority address is selected.
EMAIL_WOMEN_SUPPORT_RECIPIENT=
# Persistent local outbox. Jobs stay queued across backend restarts and retry
# until EmailJS is reachable again.
EMAIL_QUEUE_DB_PATH=data/email_queue.sqlite3
EMAIL_QUEUE_POLL_SECONDS=5
# After repeated failures, retry at least every 30 seconds by default.
EMAIL_QUEUE_MAX_BACKOFF_SECONDS=30
EMAIL_QUEUE_WORKER_ENABLED=true

# --- Pollinations.ai needs no key, listed here for reference only ---
# POLLINATIONS_BASE_URL=https://image.pollinations.ai/prompt
